{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FLH063ObjectsUnderTaskPrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::flh063-*/flh063/*"
    },
    {
      "Sid": "FLH063ListAndVerifyBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging"
      ],
      "Resource": "arn:aws:s3:::flh063-*"
    }
  ]
}
