    {
     "state": "approved",
     "text": "Ask which preposition the place takes: « à » gives « y », « de » gives « en ».",
     "type": "contrast",
     "unit_id": "k-0d3281b28da6"
    },
    {
     "state": "approved",
     "text": "« y » replaces a place introduced by « à »: « Tu vas à la boulangerie ? — Oui, j'y vais. »",
     "type": "claim",
     "unit_id": "k-6c4760ebee9d"
    },
    {
     "state": "approved",
     "text": "« en » replaces a place introduced by « de »: « Je viens de la boulangerie, j'en viens. »",
     "type": "claim",
     "unit_id": "k-40cbe73ae3f5"
    }
   ]
  },
