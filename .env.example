# Configuration reference/template. Every value below is optional: the defaults
# work without any file.
#
# The server (cmd/server) reads an optional `.env` file from its working
# directory, normally the repository root when started with `make run` or
# `go run ./cmd/server`. To use one, copy this file to `.env` and edit it.
#
# - A variable already set in the process environment always wins over `.env`,
#   even when it is set to an empty string. `.env` never changes the process
#   environment.
# - An empty value behaves as unset, so `OPENAI_API_KEY=` keeps the default.
# - A missing `.env` is fine. A malformed one stops startup with an error that
#   names the problem but never shows file contents.
# - Syntax is KEY=value, one per line; `#` starts a comment. Unquoted and
#   double-quoted values expand `$NAME`/`${NAME}` from earlier lines in the
#   file, so wrap any value containing `$` or `#` in single quotes:
#   OPENAI_API_KEY='value-with-$-kept-literally'
#
# `.env` is ignored by Git. Never commit it, and never put real keys in this
# example file.

# HTTP port the server listens on.
PORT=8080

# Path to the SQLite database file (created on first run).
DB_PATH=data/app.db

# Browser-request boundary (not authentication). Loopback Host names are always
# allowed. Add exact NAS names/IPs here; no ports, wildcards, schemes or paths.
# HTTP_ALLOWED_HOSTS=nas.home,192.168.1.20,fd00::20
# Trusted origins are exact HTTP(S) scheme://host[:port], no trailing slash.
# Empty/unset defaults to http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
# A nonempty list REPLACES those development defaults. Add Vite origins if its
# port changes, or a trusted reverse proxy HTTPS origin (headers are not trusted).
# HTTP_TRUSTED_ORIGINS=http://localhost:5174

# HTTP timeouts in seconds.
HTTP_READ_TIMEOUT=10
HTTP_WRITE_TIMEOUT=10

# ---- Analyzer provider ----
# Which analyzer produces metadata for POST /entries/{id}/analysis.
#   rule-based  (default) local, deterministic, no external calls, no cost.
#   openai      opt-in; calls the OpenAI Responses API (billed separately from
#               any ChatGPT subscription).
AI_PROVIDER=rule-based

# ---- Knowledge extractor provider ----
# Independent of AI_PROVIDER. Disabled by default; "openai" enables explicit
# knowledge extraction through the OpenAI Responses API.
EXTRACTOR_PROVIDER=disabled

# ---- OpenAI settings ----
# Used when AI_PROVIDER=openai or EXTRACTOR_PROVIDER=openai. Set the key in your
# local .env or the process environment; never commit the real value.
# OPENAI_API_KEY=replace-with-your-key

# Required when either OpenAI-backed capability is enabled.
# OPENAI_MODEL=gpt-4o-mini

# API base URL. Default is the public OpenAI API; override for a compatible
# gateway or a local test server.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Per-request provider timeout in seconds. Kept below HTTP_WRITE_TIMEOUT so a
# provider call cannot normally outlive the HTTP response deadline.
# OPENAI_TIMEOUT=8

# ---- Semantic retrieval embedding provider (milestone 12-D) ----
# Independent of AI_PROVIDER and EXTRACTOR_PROVIDER.
#   disabled  (default) no semantic retriever is registered.
#   http      calls an OpenAI-compatible POST <base-url>/embeddings endpoint.
EMBEDDING_PROVIDER=disabled

# Required when EMBEDDING_PROVIDER=http. The service may be hosted remotely,
# on rented compute, or on another local machine.
# EMBEDDING_MODEL=multilingual-embedding-model
# EMBEDDING_BASE_URL=https://embedding-service.example/v1

# Optional bearer token. A trusted local service may omit it.
# EMBEDDING_API_KEY=replace-with-your-key

# Per-request embedding timeout in seconds.
# EMBEDDING_TIMEOUT=8

# ---- Optional persistent semantic search (FLH-040) ----
# disabled (default) or qdrant. qdrant also requires EMBEDDING_PROVIDER=http.
# Build the index explicitly with the semantic-index CLI; see
# docs/SEMANTIC_SEARCH.md. The server never indexes on its own.
SEMANTIC_SEARCH=disabled

# Required when SEMANTIC_SEARCH=qdrant. One Qdrant instance; loopback only.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=replace-if-your-qdrant-requires-one
# QDRANT_TIMEOUT=5
# QDRANT_COLLECTION_PREFIX=flh_concepts

# Required when SEMANTIC_SEARCH=qdrant: the explicit identity of the embedding
# model AND deployment (change it whenever the model, version or weights
# change) and its vector dimensions. Cached vectors are keyed by these.
# EMBEDDING_MODEL_ID=provider/model-name@version
# EMBEDDING_DIMENSIONS=1024

# Documents per provider/vector-store call (1-256).
# SEMANTIC_BATCH_SIZE=32

# ---- Listener (FLH-036) ----
# Optional IP literal to bind; empty listens on all interfaces.
# LISTEN_HOST=127.0.0.1
