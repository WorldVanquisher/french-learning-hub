+func TestLocalTranscriberSendsNoKeyAndNamesTheLocalModel(t *testing.T) {
+	var gotAuth, gotModel string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotAuth = r.Header.Get("Authorization")
+		if err := r.ParseMultipartForm(1 << 20); err != nil {
+			t.Errorf("multipart: %v", err)
+		}
+		gotModel = r.FormValue("model")
+		_, _ = io.WriteString(w, `{"text":"Bonjour.","flh":{"status":"transcribed"}}`)
+	}))
+	defer srv.Close()
+	tr := speaking.NewLocalTranscriber("whisper-base@e37978b90ca9/flh_speaking_transcribe_v1/cpu-fp32/0123456789abcdef", srv.URL+"/v1/", time.Second)
+	if tr.Name() != "local:whisper-base@e37978b90ca9/flh_speaking_transcribe_v1/cpu-fp32/0123456789abcdef:"+domain.SpeakingTranscriptionVersion {
+		t.Fatalf("name = %q", tr.Name())
+	}
+	got, err := tr.Transcribe(context.Background(), domain.SpeakingTranscriptionInput{Audio: synthWAV(), Format: wavFormat(t)})
+	if err != nil || got != "Bonjour." || gotAuth != "" || !strings.HasPrefix(gotModel, "whisper-base@") {
+		t.Fatalf("text %q err %v auth %q model %q", got, err, gotAuth, gotModel)
+	}
+	if speaking.NewTranscriber(key, "m", srv.URL, time.Second).Name() != "openai:m:"+domain.SpeakingTranscriptionVersion {
+		t.Fatal("openai provenance changed")
+	}
