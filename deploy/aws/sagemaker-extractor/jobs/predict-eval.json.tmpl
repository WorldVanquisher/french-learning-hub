{
  "TrainingJobName": "${JOB_NAME}",
  "AlgorithmSpecification": {
    "TrainingImage": "${IMAGE_URI_BY_DIGEST}",
    "TrainingInputMode": "File",
    "ContainerEntrypoint": [
      "python3",
      "-B",
      "-m",
      "flh_extraction.sagemaker_entry"
    ],
    "ContainerArguments": [
      "predict"
    ]
  },
  "RoleArn": "${EXEC_ROLE_ARN}",
  "HyperParameters": {
    "prompts_sha256": "${PROMPTS_SHA256}",
    "max_new_tokens": "512",
    "template_kwargs": "{\"enable_thinking\": false}",
    "model_profile": "qwen3.5-4b"
  },
  "InputDataConfig": [
    {
      "ChannelName": "prompts",
      "InputMode": "File",
      "ContentType": "application/jsonl",
      "DataSource": {
        "S3DataSource": {
          "S3DataType": "S3Prefix",
          "S3Uri": "s3://${BUCKET}/extractor/prompts/${PROMPTS_SHA256}/",
          "S3DataDistributionType": "FullyReplicated"
        }
      }
    },
    {
      "ChannelName": "model",
      "InputMode": "File",
      "ContentType": "application/octet-stream",
      "DataSource": {
        "S3DataSource": {
          "S3DataType": "S3Prefix",
          "S3Uri": "s3://${BUCKET}/extractor/models/${BASE_MODEL_KEY}/",
          "S3DataDistributionType": "FullyReplicated"
        }
      }
    },
    {
      "ChannelName": "adapter",
      "InputMode": "File",
      "ContentType": "application/octet-stream",
      "DataSource": {
        "S3DataSource": {
          "S3DataType": "S3Prefix",
          "S3Uri": "s3://${BUCKET}/extractor/adapters/${ADAPTER_KEY}/",
          "S3DataDistributionType": "FullyReplicated"
        }
      }
    }
  ],
  "OutputDataConfig": {
    "S3OutputPath": "s3://${BUCKET}/extractor/output/"
  },
  "ResourceConfig": {
    "InstanceType": "ml.g5.xlarge",
    "InstanceCount": 1,
    "VolumeSizeInGB": 50
  },
  "StoppingCondition": {
    "MaxRuntimeInSeconds": 3600
  },
  "EnableNetworkIsolation": true,
  "EnableManagedSpotTraining": false,
  "Tags": [
    {
      "Key": "Project",
      "Value": "flh"
    },
    {
      "Key": "Component",
      "Value": "extractor-sft"
    },
    {
      "Key": "Run",
      "Value": "predict"
    },
    {
      "Key": "DatasetSha256",
      "Value": "${TRAIN_SHA256}"
    },
    {
      "Key": "ImageDigest",
      "Value": "${IMAGE_DIGEST}"
    }
  ]
}
