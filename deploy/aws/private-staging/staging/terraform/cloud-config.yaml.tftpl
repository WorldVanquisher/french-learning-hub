#cloud-config
# FLH staging host (proposed). Installs Docker, the pinned Compose plugin and
# sqlite (flh-daily.sh backup/restore need the sqlite3 CLI), mounts the data
# volume, installs the settings renderer, the bundle tool and the
# bounded-runtime timer, and gives ec2-user (uid 1000 = the container's
# FLH_UID) Docker access and the staging directories. It downloads no release
# and starts no service: the operator installs a bundle over SSM as ec2-user
# (deploy/aws/private-staging/RUNBOOK.md, section 5).
package_update: false
packages:
  - docker
  - python3
  - sqlite
  - tar
write_files:
  - path: /usr/local/bin/flh-staging-env
    permissions: "0755"
    content: |
      ${indent(6, render_env)}
  - path: /usr/local/bin/flh-staging-bundle
    permissions: "0755"
    content: |
      ${indent(6, bundle_tool)}
  - path: /etc/systemd/system/flh-staging-expire.service
    permissions: "0644"
    content: |
      ${indent(6, expire_unit)}
  - path: /etc/systemd/system/flh-staging-expire.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=FLH staging: power off ${max_runtime_hours} h after boot
      [Timer]
      OnBootSec=${max_runtime_hours}h
      AccuracySec=1min
      [Install]
      WantedBy=timers.target
  - path: /etc/flh/staging.conf
    permissions: "0644"
    content: |
      REGION=${region}
      BUCKET=${bucket}
      PARAM_DIR=${param_dir}
      ROOT=${root}
      PORT=${port}
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, ${expire_timer_verb}, --now, flh-staging-expire.timer]
  - [systemctl, enable, --now, docker]
  - [usermod, -aG, docker, ec2-user]
  - [mkdir, -p, /usr/local/lib/docker/cli-plugins]
  - [curl, -fsSL, -o, /usr/local/lib/docker/cli-plugins/docker-compose, "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"]
  - [sh, -c, "echo '${compose_sha256}  /usr/local/lib/docker/cli-plugins/docker-compose' | sha256sum -c - || { rm -f /usr/local/lib/docker/cli-plugins/docker-compose; exit 1; }"]
  - [chmod, "0755", /usr/local/lib/docker/cli-plugins/docker-compose]
  # Data volume: the attached EBS volume (not the root disk). Formatted only if blank.
  - [sh, -c, "for i in $(seq 1 60); do d=$(lsblk -dnpo NAME,SERIAL | awk '$2 ~ /^vol/ {print $1}' | while read n; do [ \"$n\" = \"$(findmnt -no SOURCE / | sed 's/p[0-9]*$//')\" ] || echo $n; done | head -1); [ -n \"$d\" ] && break; sleep 5; done; [ -n \"$d\" ] || exit 1; blkid \"$d\" || mkfs.xfs -L flh-data \"$d\"; mkdir -p ${root}/data; grep -q 'LABEL=flh-data' /etc/fstab || echo \"LABEL=flh-data ${root}/data xfs defaults,nofail 0 2\" >> /etc/fstab; mount ${root}/data"]
  # Layout (RUNBOOK.md): data/app = FLH_DATA_DIR, data/app.backups = flh-daily.sh backups,
  # transfer/ = incoming backups, bundles/ + current/previous = flh-staging-bundle.
  # flh-daily.sh requires FLH_DATA_DIR private and owned by FLH_UID (1000).
  - [sh, -c, "mkdir -p ${root}/bundles ${root}/transfer ${root}/data/app && chown 1000:1000 ${root} ${root}/bundles ${root}/transfer ${root}/data ${root}/data/app && chmod 0700 ${root}/data ${root}/data/app"]
