{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamHostRoleOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/flh-demo-host-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/flh-demo-host-boundary"
        }
      }
    },
    {
      "Sid": "IamHostRoleTags",
      "Effect": "Allow",
      "Action": [
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/flh-demo-host-*"
    },
    {
      "Sid": "IamHostInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:instance-profile/flh-demo-host-*"
    },
    {
      "Sid": "IamPassHostRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/flh-demo-host-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        },
        "ArnLike": {
          "iam:AssociatedResourceARN": "arn:aws:ec2:*:__AWS_ACCOUNT_ID__:instance/*"
        }
      }
    },
    {
      "Sid": "S3CreateArtifactBucket",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::flh-demo-artifacts-*"
    },
    {
      "Sid": "S3ManageArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketTagging",
        "s3:TagResource",
        "s3:UntagResource"
      ],
      "Resource": "arn:aws:s3:::flh-demo-artifacts-*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        }
      }
    },
    {
      "Sid": "S3DeleteArtifactObjectsForTeardown",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::flh-demo-artifacts-*/*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        }
      }
    },
    {
      "Sid": "DenyRoleBoundaryChanges",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/*"
    },
    {
      "Sid": "DenyEditingGuardPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/flh-demo-host-boundary",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/flh-demo-deploy",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/flh-demo-deploy-ec2",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/flh-demo-operate"
      ]
    }
  ]
}
